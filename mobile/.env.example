# API base URL — set to your machine's local IP when testing on a physical device,
# or use localhost when running in a simulator.
# Example for local dev:
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1
# Example for production:
#   EXPO_PUBLIC_API_URL=https://api.lenslog.app/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
