# LensLog — Production Environment
# Usage:
#   1. cp backend/.env.prod backend/.env
#   2. Replace every CHANGE_ME value (use: openssl rand -hex 32)
#   3. Fill in CWA_API_KEY from your existing backend/.env
#
# DO NOT commit backend/.env — it contains real secrets.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_DB_PASSWORD@db:5432/lenslog
DB_PASSWORD=CHANGE_DB_PASSWORD

# ── JWT ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MinIO Storage ─────────────────────────────────────────
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_URL=https://grindstones.org/storage
STORAGE_ACCESS_KEY=CHANGE_MINIO_USER
STORAGE_SECRET_KEY=CHANGE_MINIO_PASSWORD
STORAGE_BUCKET_NAME=lenslog
STORAGE_REGION=ap-northeast-1
PHOTO_UPLOAD_MAX_SIZE_MB=20
PHOTO_PRESIGN_EXPIRE_SECONDS=3600

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── External APIs ─────────────────────────────────────────
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
SUNRISE_SUNSET_API_URL=https://api.sunrise-sunset.org/json
CWA_BASE_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore
CWA_API_KEY=COPY_FROM_EXISTING_ENV

# ── Email (optional for demo — leave as-is if not needed) ─
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=unused
MAIL_FROM=noreply@grindstones.org
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=https://grindstones.org

# ── Debug ─────────────────────────────────────────────────
DEBUG=False
