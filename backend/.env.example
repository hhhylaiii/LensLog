# ============================================================
# 本機開發（不使用 Docker）設定範本
# 使用方式：cp .env.example .env，再依需求修改
#
# 如果使用 Docker（docker-compose up），不需要此 .env 檔案。
# 所有 Docker 環境變數已在 docker-compose.yml 中設定好。
# ============================================================

# 資料庫
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lenslog

# JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (支援 MinIO / Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=lenslog-dev
STORAGE_REGION=ap-northeast-1

# Upload limits (presigned POST policy)
PHOTO_UPLOAD_MAX_SIZE_MB=20
# Presign expiration + Redis ownership check TTL (seconds)
PHOTO_PRESIGN_EXPIRE_SECONDS=3600

# Redis
REDIS_URL=redis://localhost:6379/0

# 外部 API
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
SUNRISE_SUNSET_API_URL=https://api.sunrise-sunset.org/json
CWA_BASE_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore
CWA_API_KEY=your-cwa-api-key-here  # 申請：https://opendata.cwa.gov.tw/

# Email (SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@lenslog.app
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=  # 逗號分隔的額外允許 origins（選填）

# Debug（開發時設 True）
DEBUG=True
